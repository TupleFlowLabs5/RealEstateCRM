generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  WON
  LOST
}
enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}
enum BookingStatus {
  RESERVED
  CONFIRMED
  CANCELLED
}
enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  role UserRole @default(AGENT)
  avatar String?
  leads Lead[]
  visits SiteVisit[]
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  sessions AuthSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id String @id @default(cuid())
  tokenHash String @unique
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([accountId])
  @@index([expiresAt])
}

model ChannelPartner {
  id String @id @default(cuid())
  name String
  company String @unique
  email String? @unique
  phone String?
  commissionRate Float @default(2.5)
  leads Lead[]
  createdAt DateTime @default(now())
}

model Project {
  id String @id @default(cuid())
  name String @unique
  location String
  priceFrom Float
  status String @default("Active")
  image String?
  leads Lead[]
  visits SiteVisit[]
  bookings Booking[]
  createdAt DateTime @default(now())
}

model Lead {
  id String @id @default(cuid())
  name String
  email String? @unique
  phone String?
  source String @default("Website")
  status LeadStatus @default(NEW)
  budget Float?
  notes String?
  assignedToId String?
  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  channelPartnerId String?
  channelPartner ChannelPartner? @relation(fields: [channelPartnerId], references: [id], onDelete: SetNull)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  visits SiteVisit[]
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model SiteVisit {
  id String @id @default(cuid())
  startsAt DateTime
  status VisitStatus @default(SCHEDULED)
  notes String?
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  agentId String?
  agent User? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([startsAt])
}

model Booking {
  id String @id @default(cuid())
  unitNumber String
  amount Float
  status BookingStatus @default(RESERVED)
  bookedAt DateTime @default(now())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  agentId String?
  agent User? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  @@index([bookedAt])
}

model Automation {
  id String @id @default(cuid())
  name String
  trigger String
  description String
  active Boolean @default(true)
  runsThisMonth Int @default(0)
  createdAt DateTime @default(now())
}
